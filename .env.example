# Copy to .env (never commit it) or pass these via your MCP client's "env" block.
# Easiest: run `node dist/index.js --login` once (browser sign-in, Google/Apple work). No env vars needed.
# Auth option A: raw access JWT (copy from the `piniaAccess` cookie on gregmat.com)
GREGMAT_TOKEN=
# Auth option B: full Cookie header string from a logged-in gregmat.com tab (piniaAccess is extracted)
GREGMAT_COOKIE=
# Auth option C: automatic BROWSER login (needs a display; headless Linux: xvfb-run). Not for Google/Apple-only accounts.
GREGMAT_EMAIL=
GREGMAT_PASSWORD=
# Optional: Chrome/Chromium binary for browser login (default: system Chrome, then Playwright Chromium)
GREGMAT_CHROME_PATH=
# Optional overrides
GREGMAT_TEST_DATE=
GREGMAT_STUDY_PLAN=
GREGMAT_MCP_HOME=
GREGMAT_API_BASE=
GREGMAT_TIMEOUT_MS=
GREGMAT_CACHE_TTL_MS=
GREGMAT_DEBUG=
